# === LLM Provider ===
# nvidia | gemini | oxalpha
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=PASTE_YOUR_NVIDIA_API_KEY_HERE
NVIDIA_MODEL=meta/llama-3.1-405b-instruct
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

OX_ALPHA_API_KEY=
OX_ALPHA_BASE_URL=https://api.oxalpha.com/v1
OX_ALPHA_MODEL=ox-alpha

DATABASE_URL=sqlite:///./vibepromt.db
REQUEST_LIMIT_PER_MINUTE=60
HOST=127.0.0.1
PORT=8000

# === Telegram + ngrok ===
# Токен бота: @BotFather → /token
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
# HTTPS URL мини-приложения (из окна ngrok) — тот же URL в BotFather
MINI_APP_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev
ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_ID
# Токен ngrok: https://dashboard.ngrok.com/get-started/your-authtoken
# Домен: https://dashboard.ngrok.com/domains  (бесплатный *.ngrok-free.app / *.ngrok-free.dev)
NGROK_DOMAIN=YOUR-SUBDOMAIN.ngrok-free.dev
